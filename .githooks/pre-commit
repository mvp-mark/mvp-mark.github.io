#!/bin/sh
# Regenerates the per-language pages (json/scripts/build-pages.js) and keeps
# CACHE_NAME in json/sw.js in step with the files it caches
# (json/scripts/sw-version.js), so a commit never ships them stale.
# Enable once per clone with:  git config core.hooksPath .githooks
# Note: it adds those generated files as they are in the working tree.
if git diff --cached --name-only | grep -q '^json/'; then
  node json/scripts/build-pages.js >/dev/null || exit 1
  node json/scripts/sw-version.js >/dev/null || exit 1
  git add json/index.html json/??/index.html json/sitemap.xml json/sw.js
fi
